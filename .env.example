# Application

FLASK_ENV=development
SECRET_KEY=your_secret_key
BASE_URL=https://127.0.0.1:5000
TARGET_URL=https://127.0.0.1:5001

ATTACK_TARGET_URL=https://127.0.0.1:443

MITMPROXY_UPSTREAM_CA=certs/mkcert-rootCA.pem
MITMPROXY_AUDITOR_CA=certs/mkcert-rootCA.pem
MITMPROXY_CLIENT_CA=certs/mitmproxy-ca-cert.pem

# Network

AUDITOR_HOST=127.0.0.1
AUDITOR_PORT=5000

TARGET_HOST=127.0.0.1
TARGET_PORT=5001

MITMPROXY_HOST=127.0.0.1
MITMPROXY_PORT=443

# Database

DATABASE_PATH=instance/security.db

# Administrator

ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin_password

# Audit

AUDIT_SELF_TRAFFIC=false
AUDITOR_ATTACK_RESULTS_API_URL=https://127.0.0.1:5000/api/v1/audit/attack-results
AUDITOR_CAPTURE_API_URL=https://127.0.0.1:5000/api/v1/audit/captures

ATTACK_SIMULATOR_API_KEY=tsa_your_key
MITMPROXY_CAPTURE_API_KEY=tsa_your_key

# Security / Testing

INVITE_TOKEN=DEMO-INVITE-2026
ALLOWED_TEST_HOSTS=127.0.0.1,localhost
TRUSTED_ORIGINS=https://127.0.0.1:5000,https://localhost:5000

# Uploads

MAX_CONTENT_LENGTH=2147483648
UPLOAD_CHUNK_SIZE=8388608
UPLOAD_DIR=instance/uploads

# GitHub OAuth

GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Keycloak

KEYCLOAK_CLIENT_ID=
KEYCLOAK_CLIENT_SECRET=
KEYCLOAK_SERVER_METADATA_URL=http://keycloak:8080/realms/token-auditor/.well-known/openid-configuration

# MinIO

MINIO_ENDPOINT=minio:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=change-minio-password
MINIO_SECURE=false
MINIO_BUCKET=token-auditor
ENABLE_MINIO=false